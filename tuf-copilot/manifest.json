{
  "manifest_version": 3,
  "name": "TUF Copilot",
  "version": "1.0.0",
  "description": "Extracts problems and code from takeUforward and analyzes them instantly with ChatGPT.",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://takeuforward.org/*"],
      "js": ["content.js"]
    },
    {
      "matches": ["*://chatgpt.com/*"],
      "js": ["chatgpt.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://takeuforward.org/*"]
    }
  ]
}